{
  "name": "mutuity-mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "adb reverse tcp:3000 tcp:3000; adb reverse tcp:5050 tcp:5050; TARGET_ENV=local expo start -c",
    "start:local": "adb reverse tcp:3000 tcp:3000; adb reverse tcp:5050 tcp:5050; TARGET_ENV=local expo start -c",
    "start:test": "TARGET_ENV=test expo start -c",
    "start:prod": "TARGET_ENV=prod expo start -c",
    "graphql:schema": "graphql-codegen --config codegen.schema.cjs",
    "graphql:codegen": "graphql-codegen --config codegen.cjs",
    "typecheck": "npm run graphql:schema && npm run graphql:codegen && tsc --noEmit",
    "guard:ui-contract-gate": "node ../scripts/check-ui-contract-gate.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:integration": "jest --testPathPattern=tests/integration",
    "e2e": "detox test",
    "android": "adb reverse tcp:3000 tcp:3000; adb reverse tcp:5050 tcp:5050; TARGET_ENV=local expo run:android",
    "ios": "TARGET_ENV=local expo run:ios",
    "android:test": "TARGET_ENV=test expo run:android",
    "ios:test": "TARGET_ENV=test expo run:ios",
    "android:prod": "TARGET_ENV=prod expo run:android",
    "ios:prod": "TARGET_ENV=prod expo run:ios",
    "storybook": "TARGET_ENV=local EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start -c",
    "storybook:ios": "TARGET_ENV=local EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "storybook:android": "TARGET_ENV=local EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:android"
  },
  "dependencies": {
    "@apollo/client": "^4.2.5",
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "^4.5.6",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "@types/react": "~19.0.10",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-location": "~18.1.6",
    "expo-secure-store": "~14.2.4",
    "graphql": "^16.14.2",
    "i18next": "^26.3.4",
    "react": "19.0.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.15.3",
    "react-native-paper-dates": "^0.23.14",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "rxjs": "^7.8.2",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/schema-ast": "^6.0.1",
    "@graphql-codegen/typed-document-node": "^7.0.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.5",
    "@storybook/addon-ondevice-actions": "^10.4.7",
    "@storybook/react-native": "^10.4.7",
    "@storybook/react-native-ui-lite": "^10.4.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "prettier": "^3.4.2",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.0.0",
    "storybook": "^10.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
