# Runtime API, Maps and Cloudinary settings live in config/environments/<TARGET_ENV>.json.
# npm scripts and EAS profiles select TARGET_ENV; this URL is only for schema tooling.
EXPO_PUBLIC_GRAPHQL_URL=http://127.0.0.1:5000/graphql
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
EXPO_PUBLIC_SUBSCRIPTIONS_URL=ws://127.0.0.1:5000/graphql
EXPO_PUBLIC_DIAGNOSTIC=true
EXPO_ANDROID_GOOGLE_MAPS_API_KEY=
EXPO_IOS_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_CLOUDINARY_CLOUD=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Optional PUBLIC GlitchTip project DSN. Empty disables monitoring completely.
# Only non-development native builds for TARGET_ENV=test|review|prod send events.
EXPO_PUBLIC_GLITCHTIP_DSN=
# Build-only source-map upload configuration; NEVER use EXPO_PUBLIC_ for secrets.
SENTRY_ORG=
SENTRY_PROJECT=
# Set SENTRY_AUTH_TOKEN only in the build runner's secret environment, never here.
# Opt out of automatic artifact uploads for local/offline builds:
SENTRY_DISABLE_AUTO_UPLOAD=true