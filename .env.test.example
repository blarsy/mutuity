# Copy to .env.test on the dedicated test Docker host. Use test-only credentials.

# PostgreSQL (volume and network are isolated from production/review)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-test-only-password
POSTGRES_DB=mutuity
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5532
EDGE_NETWORK_NAME=mutuity-test-edge
EDGE_BACKEND_ALIAS=backend-test
EDGE_FRONTEND_ALIAS=frontend-test

# Public URLs and CORS
FRONTEND_URL=https://test.tope-la.com
BACKEND_CORS_ORIGINS=https://test.tope-la.com

# Backend auth hardening (never reuse production secrets)
SESSION_SECRET=replace-with-a-test-only-session-secret
SOCIAL_AUTH_STATE_SECRET=replace-with-a-test-only-oauth-state-secret
SESSION_COOKIE_NAME=mutuity_test_session
SESSION_TTL_HOURS=168
ALLOW_DEV_AUTH_HEADERS=false

# Backend runtime
PASSWORD_HASH_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Mail delivery disabled on the test stack by default
MAIL_DELIVERY_ENABLED=false
MAIL_WEB_APP_URL=https://test.tope-la.com
MAIL_PRODUCT_NAME=Tope-là Test
MAIL_FROM_ADDRESS=Tope-là Test <test-noreply@example.com>
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net

# Worker
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2000

# Frontend public config
NEXT_PUBLIC_GRAPHQL_URL=https://test.tope-la.com/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=wss://test.tope-la.com/graphql
NEXT_PUBLIC_BACKEND_URL=https://test.tope-la.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# OAuth: use test callback registrations/credentials, never production values
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://test.tope-la.com/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_CALLBACK_URL=https://test.tope-la.com/auth/apple/callback
