[Unit]
Description=Encrypted Mutuity PostgreSQL backup to R2
Wants=network-online.target
After=network-online.target docker.service
OnFailure=mutuity-backup-failure.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/bin/bash /opt/mutuity/deploy/backup/backup.sh
StateDirectory=mutuity-backup
StateDirectoryMode=0700
TimeoutStartSec=6h
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mutuity-backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6