[Unit]
Description=Signal failed Mutuity backup (including timeout or termination)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/bin/bash /opt/mutuity/deploy/backup/backup.sh --failure-signal
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6