# Trusted Bash configuration: root:root 0600; parent /etc/mutuity root:root 0700.
# No private age identity on this host. Keep independent recovery copies off-host.
REPO_DIR=/opt/mutuity
COMPOSE_PROJECT=mutuity-prod
COMPOSE_FILE=/opt/mutuity/docker-compose.prod.yml
COMPOSE_ENV_FILE=/opt/mutuity/.env.prod
STATE_DIR=/var/lib/mutuity-backup
AGE_RECIPIENT=age1REPLACE_WITH_OFF_HOST_RECOVERY_PUBLIC_KEY
R2_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=mutuity-backups
R2_PREFIX=postgres
AWS_ACCESS_KEY_ID=REPLACE_BUCKET_SCOPED_OBJECT_READ_WRITE_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_SECRET
SUCCESS_HEARTBEAT_URL=https://REPLACE_MONITOR/REPLACE_SECRET_SUCCESS_PATH
# Optional: only set a failure URL explicitly documented by your provider.
# GlitchTip needs only its success heartbeat URL; do not append /fail to it.
FAILURE_HEARTBEAT_URL=