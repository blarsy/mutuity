{
	email {$CADDY_EMAIL}
}

test.tope-la.com {
	encode zstd gzip

	# Do not send processed OAuth results back through the provider handler.
	@webOAuthResult {
		method GET
		path /auth/google/callback /auth/apple/callback
		query status=*
	}

	handle @webOAuthResult {
		reverse_proxy {$TEST_FRONTEND_UPSTREAM}
	}

	@mobileApi {
		path /graphql /graphql/* /v0_13/graphql /v0_13/graphql/ /health /auth /auth/*
	}

	handle @mobileApi {
		reverse_proxy {$TEST_API_UPSTREAM}
	}

	handle_path /api/* {
		reverse_proxy {$TEST_API_UPSTREAM}
	}

	redir /api /api/ 308

	@staticAssets {
		path /_next/* /favicon.ico /robots.txt /sitemap.xml
	}
	header @staticAssets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy {$TEST_FRONTEND_UPSTREAM}
}

{$MONITORING_HOST:errors.test.tope-la.com} {
	encode gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy {$TEST_GLITCHTIP_UPSTREAM:glitchtip-test:8000}
}
