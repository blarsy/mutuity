# Copy to .env.ingress. Public DNS for these hosts must point to the ingress.
CADDY_EMAIL=topela.tech@gmail.com
CADDY_DATA_VOLUME=mutuity-prod_caddy_data
CADDY_CONFIG_VOLUME=mutuity-prod_caddy_config
PRODUCTION_WEB_HOST=app.example.com
PRODUCTION_API_HOST=api.example.com
PRODUCTION_MOBILE_API_HOST=www.tope-la.com

# Both application stacks attach these stable aliases to mutuity-edge.
PRODUCTION_FRONTEND_UPSTREAM=frontend-prod:3000
PRODUCTION_API_UPSTREAM=backend-prod:5050
REVIEW_FRONTEND_UPSTREAM=frontend-review:3000
REVIEW_API_UPSTREAM=backend-review:5050
# Release state: set this to the currently live app version before first use.
PRODUCTION_APP_VERSION=1.0.0
# Exactly one candidate version is routed to review; use the sentinel for none.
REVIEW_CANDIDATE_VERSION=__NO_REVIEW_CANDIDATE__

# Existing test hostname; defaults to production to preserve current routing.
TEST_FRONTEND_UPSTREAM=frontend-prod:3000
TEST_API_UPSTREAM=backend-prod:5050