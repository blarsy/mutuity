# Copy to .env.review. Use secrets distinct from production.

# PostgreSQL (separate database volume; host port is local-only and unique)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-distinct-review-password
POSTGRES_DB=mutuity
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5533
EDGE_BACKEND_ALIAS=backend-review
EDGE_FRONTEND_ALIAS=frontend-review

# Public URLs and CORS
FRONTEND_URL=https://review.tope-la.com
BACKEND_CORS_ORIGINS=https://review.tope-la.com

# Backend auth hardening (generate distinct random secrets)
SESSION_SECRET=replace-with-a-distinct-review-session-secret
SOCIAL_AUTH_STATE_SECRET=replace-with-a-distinct-review-oauth-state-secret
SESSION_COOKIE_NAME=mutuity_review_session
SESSION_TTL_HOURS=168
ALLOW_DEV_AUTH_HEADERS=false

# Backend runtime
PASSWORD_HASH_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Mail delivery: keep disabled unless review mail is safely isolated
MAIL_DELIVERY_ENABLED=false
MAIL_WEB_APP_URL=https://review.tope-la.com
MAIL_PRODUCT_NAME=Tope-là Review
MAIL_FROM_ADDRESS=Tope-là Review <review-noreply@example.com>
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net

# Worker
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2000

# Frontend public config
NEXT_PUBLIC_GRAPHQL_URL=https://review.tope-la.com/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=wss://review.tope-la.com/graphql
NEXT_PUBLIC_BACKEND_URL=https://review.tope-la.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Google OAuth (use review callback registrations/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://review.tope-la.com/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile

# Apple OAuth (use review callback registrations/credentials)
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_CALLBACK_URL=https://review.tope-la.com/auth/apple/callback