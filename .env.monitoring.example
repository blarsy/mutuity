# Dedicated monitoring subdomain on the Test VPS; served by the existing Test Caddy.
MONITORING_HOST=errors.test.tope-la.com
EDGE_NETWORK_NAME=mutuity-test-edge
MONITORING_EDGE_ALIAS=glitchtip-test
# Use a long hex password (URL-safe; no percent-encoding ambiguity).
GLITCHTIP_DB_PASSWORD=replace_with_random_hex
GLITCHTIP_SECRET_KEY=replace_with_different_random_hex
# Percent-encode reserved characters in SMTP user/password; use TLS-capable SMTP.
GLITCHTIP_EMAIL_URL=smtp+tls://username:password@smtp.example.com:587
GLITCHTIP_FROM_EMAIL=alerts@example.com